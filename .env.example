# Server Port
PORT=5000
NODE_ENV=development

# JWT Secret for Student/Driver/Admin authentication
JWT_SECRET=nitte_bus_tracker_secret_2026

# Database Configuration:
# - By default, NITTE Bus Tracker uses an embedded SQLite database (sql.js WASM) with zero setup required.
# - To connect to an external PostgreSQL database (e.g. Supabase, Neon, or local Postgres), uncomment below:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/nitte_bus
